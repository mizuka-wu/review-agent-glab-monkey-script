{
  "name": "review-agent-glab-monkey-script",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "description": "GitLab review agent userscript with real diff review, selection chat, and confirmed discussion publishing.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "build": "pnpm typecheck && vite build && node scripts/generate-meta.js",
    "check": "pnpm typecheck && pnpm test",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site && node scripts/copy-doc-redirects.mjs",
    "docs:preview": "vitepress preview docs-site"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "opfs-worker": "^2.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-monkey": "^8.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  }
}
