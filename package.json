{
  "name": "review-agent-glab-monkey-script",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "GitLab review agent userscript with real diff review, selection chat, and confirmed discussion publishing.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "build": "pnpm typecheck && vite build",
    "check": "pnpm typecheck && pnpm test",
    "preview": "vite preview"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.75",
    "@assistant-ui/ai-sdk": "^0.0.8",
    "@assistant-ui/react": "^0.15.22",
    "@assistant-ui/react-markdown": "^0.14.17",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@mcp-b/webmcp-polyfill": "^5.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.114",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.13",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-monkey": "^8.0.0",
    "vitest": "^5.0.2"
  }
}
